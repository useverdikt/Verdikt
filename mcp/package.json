{
  "name": "@useverdikt/mcp",
  "version": "0.1.4",
  "description": "Verdikt MCP server — trust layer tools for AI coding agents",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "verdikt-mcp": "src/index.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/useverdikt/Verdikt.git",
    "directory": "mcp"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --check src/index.js && node --check src/client.js && node --check src/session.js && node --check src/gateFormat.js && node --test src/gateFormat.test.js src/session.test.js src/client.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "verdikt",
    "mcp",
    "ai-agents",
    "release-certification",
    "model-context-protocol"
  ],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@useverdikt/shared": "file:../shared",
    "zod": "4.6.7"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "fast-uri": "3.1.9",
    "body-parser": "2.4.0",
    "ip-address": "10.7.5",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "axios": "1.20.0",
    "follow-redirects": "1.16.1",
    "zod": "4.6.7"
  }
}
