{
  "name": "@useverdikt/shared",
  "version": "1.0.0",
  "description": "Shared Verdikt config, severity, release-status, frozen verdict, audit-chain, and independent-verify helpers",
  "main": "./config.cjs",
  "exports": {
    ".": {
      "import": "./config.mjs",
      "require": "./config.cjs",
      "default": "./config.cjs"
    },
    "./config.js": {
      "import": "./config.mjs",
      "require": "./config.cjs"
    },
    "./config.cjs": "./config.cjs",
    "./config.mjs": "./config.mjs",
    "./severity": {
      "import": "./severity.mjs",
      "require": "./severity.cjs",
      "default": "./severity.mjs"
    },
    "./severity.js": {
      "import": "./severity.mjs",
      "require": "./severity.cjs"
    },
    "./severity.mjs": "./severity.mjs",
    "./severity.cjs": "./severity.cjs",
    "./releaseStatus": {
      "import": "./releaseStatus.mjs",
      "require": "./releaseStatus.cjs",
      "default": "./releaseStatus.mjs"
    },
    "./releaseStatus.js": {
      "import": "./releaseStatus.mjs",
      "require": "./releaseStatus.cjs"
    },
    "./releaseStatus.mjs": "./releaseStatus.mjs",
    "./releaseStatus.cjs": "./releaseStatus.cjs",
    "./verdictEngine": {
      "import": "./verdictEngine.mjs",
      "require": "./verdictEngine.cjs",
      "default": "./verdictEngine.cjs"
    },
    "./auditChain": {
      "import": "./auditChain.mjs",
      "require": "./auditChain.cjs",
      "default": "./auditChain.cjs"
    },
    "./independentVerify": {
      "import": "./independentVerify.mjs",
      "require": "./independentVerify.cjs",
      "default": "./independentVerify.cjs"
    },
    "./config.json": "./config.json"
  },
  "files": [
    "config.cjs",
    "config.mjs",
    "config.json",
    "severity.mjs",
    "severity.cjs",
    "releaseStatus.mjs",
    "releaseStatus.cjs",
    "verdictEngine.mjs",
    "verdictEngine.cjs",
    "auditChain.mjs",
    "auditChain.cjs",
    "independentVerify.mjs",
    "independentVerify.cjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
