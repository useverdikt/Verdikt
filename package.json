{
  "name": "verdikt-mvp-v1",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "mcp"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "cd frontend && npx concurrently -k -n api,vite -c cyan,magenta \"npm run start --prefix ../backend\" \"npm run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "prod:check": "npm run build && npm run test",
    "prod:check:e2e": "npm run build && npm run test && npm run test:e2e",
    "test:e2e": "npm run test:e2e -w verdikt-frontend",
    "test": "npm run test:backend && npm run test:frontend && npm run test:mcp",
    "test:mcp": "npm --prefix mcp test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "check:migrations": "node scripts/check-migration-parity.js",
    "mcp": "npm --prefix mcp start",
    "seed:demos": "npm --prefix backend run seed:demos"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "hono": "4.13.1",
    "fast-uri": "3.1.5",
    "body-parser": "^2.3.0",
    "shell-quote": "^1.9.0",
    "ws": "^8.21.1",
    "postcss": "^8.5.18",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "brace-expansion@5": "5.0.8",
    "js-yaml": "4.3.1",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "nanoid": "3.3.18"
  }
}
